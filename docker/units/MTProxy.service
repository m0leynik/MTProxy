[Unit]
Description=MTProxy - Telegram MTProto proxy (Docker)
Documentation=https://github.com/TelegramMessenger/MTProxy
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/mtproxy.env
ExecStartPre=-@DOCKER@ rm -f mtproxy
ExecStart=@DOCKER@ run --rm --name mtproxy \
    -p ${HOST_PORT}:${CLIENT_PORT} \
    -e "SECRET=${SECRET}" \
    -e "TAG=${TAG}" \
    -e "WORKERS=${WORKERS}" \
    -e "CLIENT_PORT=${CLIENT_PORT}" \
    -e "STATS_PORT=${STATS_PORT}" \
    ${IMAGE}
ExecStop=-@DOCKER@ stop -t 15 mtproxy
Restart=on-failure
RestartSec=10
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
